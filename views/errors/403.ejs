<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><title>403 – Access Denied</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@800&family=Inter:wght@400;500&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Inter',sans-serif;background:#0d0d0d;color:#fff;min-height:100vh;display:flex;align-items:center;justify-content:center;text-align:center;padding:24px}
.err-code{font-family:'Syne',sans-serif;font-size:120px;font-weight:800;color:#e60000;line-height:1;letter-spacing:-4px}
.err-title{font-family:'Syne',sans-serif;font-size:28px;font-weight:800;margin:12px 0 8px}
.err-sub{color:#888;font-size:14px;margin-bottom:28px}
a{display:inline-block;padding:12px 28px;background:#e60000;color:#fff;border-radius:10px;text-decoration:none;font-weight:600;font-size:14px}
a:hover{background:#b30000}
</style>
</head>
<body>
  <div>
    <div class="err-code">403</div>
    <div class="err-title">Access Denied</div>
    <div class="err-sub">You don't have permission to view this page.</div>
    <a href="/dashboard">← Back to Dashboard</a>
  </div>
</body>
</html>
